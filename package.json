{
    "name": "cf-visualizer",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "tsx server.ts",
        "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
        "start": "node dist/server.cjs",
        "preview": "vite preview",
        "clean": "node -e \"import { rmSync } from 'fs'; rmSync('dist', { recursive: true, force: true });\"",
        "lint": "tsc --noEmit"
    },
